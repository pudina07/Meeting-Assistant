# Stage 1 - Whisper large-v3-turbo on Groq   (console.groq.com -> API Keys)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Stages 2 & 3 - Qwen2.5-72B-Instruct via OpenRouter   (openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen-2.5-72b-instruct
# json_object (default) | json_schema | none
LLM_JSON_MODE=json_object

# Optional - shown on openrouter.ai rankings
# OPENROUTER_SITE_URL=https://your-site.example
# OPENROUTER_APP_NAME=AI Meeting Assistant

# ---- Speaker diarization (optional) -------------------------------------------
# Hugging Face READ token: https://huggingface.co/settings/tokens
# You must ALSO click "Agree and access repository" on both pages (same account):
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
# DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

# ---- Large recordings (optional) ------------------------------------------------
# Audio is cut into chunks of this many seconds before it is sent to Whisper.
# STT_CHUNK_SECONDS=600
# Per-request upload limit of your STT provider, in MB (Groq free tier = 25 MB).
# Chunks above it are re-encoded (64/32 kbps) and, if still too big, split in half automatically.
# STT_MAX_UPLOAD_MB=24
